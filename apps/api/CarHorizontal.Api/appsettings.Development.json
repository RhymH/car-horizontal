{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Hangfire": {
    "DashboardEnabled": true
  },
  "Jwt": {
    "Issuer": "CarHorizontal.Api",
    "Audience": "CarHorizontal.Portal",
    "Key": "dev-only-jwt-signing-key-not-for-production-32+chars",
    "AccessMinutes": 15,
    "RefreshDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Seed": {
    "DemoUserPassword": "DemoUser!2026"
  }
}
